{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "readme_check",
  "type": "object",
  "required": ["ok", "problems"],
  "properties": {
    "ok": { "type": "boolean" },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "message"],
        "properties": {
          "kind": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "message": { "type": "string" }
        }
      }
    },
    "checks": { "type": "object" }
  }
}
