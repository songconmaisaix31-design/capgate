{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "test_report",
  "type": "object",
  "required": ["ok", "passed", "failed"],
  "properties": {
    "ok": { "type": "boolean" },
    "exit_code": { "type": "integer" },
    "passed": { "type": "integer" },
    "failed": { "type": "integer" },
    "integration": { "type": "boolean" },
    "summary": { "type": "string" }
  }
}
