{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "crawl_pages",
  "type": "object",
  "patternProperties": {
    "^page_[0-9]+$": {
      "type": "object",
      "required": ["url", "links", "text"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
